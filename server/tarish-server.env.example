# Copy this file to /etc/tarish-server.env and replace CHANGE_ME before
# starting the service.

TARISH_SERVER_ADDR=127.0.0.1:8080
TARISH_SERVER_DB=/var/lib/tarish/tarish.db
TARISH_SERVER_AGENT_KEY=CHANGE_ME

# Optional xmrig-proxy integration.
TARISH_SERVER_PROXY_URL=
TARISH_SERVER_PROXY_API_TOKEN=
